# ==============================================================================
# Supabase Configuration (Free Postgres, Auth, and Storage)
# ==============================================================================
# Create a free project at https://supabase.com
# Obtain these credentials under: Project Settings -> API
# Note: In Vite, variables exposed to the client must begin with VITE_

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
